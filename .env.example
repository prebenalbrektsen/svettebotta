# Postgres connection string. Locally: npm run db:start prints it.
DATABASE_URL=
# Public origin of the app, used for invite links and the Strava callback.
APP_URL=
# From https://www.strava.com/settings/api. Leave empty to run without Strava (manual logging only).
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
# Any long random string (e.g. openssl rand -hex 32). Vercel sends it with the reminder cron;
# without it the reminders never run.
CRON_SECRET=
